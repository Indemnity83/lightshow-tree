(footprint "WirePads_1x03_P3.50mm_20-22AWG"
  (version 20240108)
  (generator pcbnew)
  (layer "F.Cu")
  (descr "Three through-hole solder pads for 20 to 22 AWG pixel-string wiring")
  (tags "wire solder 20AWG 22AWG pixel")
  (attr through_hole)
  (fp_rect (start -2 -2) (end 9 2)
    (stroke (width 0.25) (type default)) (fill none) (layer "F.SilkS"))
  (fp_text reference "REF**" (at 3.5 -3.2) (layer "F.SilkS")
    (effects (font (size 1.1 1.1) (thickness 0.18))))
  (fp_text value "WirePads_1x03_P3.50mm_20-22AWG" (at 3.5 3.2) (layer "F.Fab")
    (effects (font (size 0.9 0.9) (thickness 0.14))))
  (fp_circle (center -1.8 0) (end -1.35 0)
    (stroke (width 0.25) (type solid)) (fill solid) (layer "F.SilkS"))
  (pad "1" thru_hole rect (at 0 0) (size 3 3) (drill 1.2) (layers "*.Cu" "*.Mask"))
  (pad "2" thru_hole circle (at 3.5 0) (size 3 3) (drill 1.2) (layers "*.Cu" "*.Mask"))
  (pad "3" thru_hole circle (at 7 0) (size 3 3) (drill 1.2) (layers "*.Cu" "*.Mask"))
