(footprint "WirePads_1x02_P3.50mm_CAT5_6"
  (version 20240108)
  (generator pcbnew)
  (layer "F.Cu")
  (descr "Two through-hole solder pads for a solid CAT5 or CAT6 differential pair")
  (tags "wire solder CAT5 CAT6 differential RS485")
  (attr through_hole)
  (fp_rect (start -2 -2) (end 5.5 2)
    (stroke (width 0.25) (type default)) (fill none) (layer "F.SilkS"))
  (fp_text reference "REF**" (at 1.75 -3.2) (layer "F.SilkS")
    (effects (font (size 1.1 1.1) (thickness 0.18))))
  (fp_text value "WirePads_1x02_P3.50mm_CAT5_6" (at 1.75 3.2) (layer "F.Fab")
    (effects (font (size 0.9 0.9) (thickness 0.14))))
  (fp_circle (center -1.8 0) (end -1.35 0)
    (stroke (width 0.25) (type solid)) (fill solid) (layer "F.SilkS"))
  (pad "1" thru_hole rect (at 0 0) (size 2.8 2.8) (drill 1.1) (layers "*.Cu" "*.Mask"))
  (pad "2" thru_hole circle (at 3.5 0) (size 2.8 2.8) (drill 1.1) (layers "*.Cu" "*.Mask"))
